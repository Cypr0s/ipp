*** Bubble sort five integers read from stdin
+++ COMPLEX
!C! 0
!I! 0
>>> 5

class Main : Object {
  run [|
    _ := self a: (String read) asInteger.
    _ := self b: (String read) asInteger.
    _ := self c: (String read) asInteger.
    _ := self d: (String read) asInteger.
    _ := self e: (String read) asInteger.

    _ := self bubblePass.
    _ := self bubblePass.
    _ := self bubblePass.
    _ := self bubblePass.

    _ := ((self a) asString) print.
    _ := ((self b) asString) print.
    _ := ((self c) asString) print.
    _ := ((self d) asString) print.
    _ := ((self e) asString) print.
  ]

  swapAB [|
    tmp := self a.
    _ := self a: (self b).
    _ := self b: tmp.
  ]
  swapBC [|
    tmp := self b.
    _ := self b: (self c).
    _ := self c: tmp.
  ]
  swapCD [|
    tmp := self c.
    _ := self c: (self d).
    _ := self d: tmp.
  ]
  swapDE [|
    tmp := self d.
    _ := self d: (self e).
    _ := self e: tmp.
  ]

  bubblePass [|
    _ := ((self a) greaterThan: (self b)) ifTrue: [| _ := self swapAB. ] ifFalse: [| _ := nil. ].
    _ := ((self b) greaterThan: (self c)) ifTrue: [| _ := self swapBC. ] ifFalse: [| _ := nil. ].
    _ := ((self c) greaterThan: (self d)) ifTrue: [| _ := self swapCD. ] ifFalse: [| _ := nil. ].
    _ := ((self d) greaterThan: (self e)) ifTrue: [| _ := self swapDE. ] ifFalse: [| _ := nil. ].
  ]
}
