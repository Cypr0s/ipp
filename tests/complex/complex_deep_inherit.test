*** Deep inheritance with super chains and polymorphic dispatch
+++ COMPLEX
!C! 0
!I! 0
>>> 5

class Shape : Object {
  describe [|
    _ := '[Shape]' print.
  ]
  area [|
    _ := 0.
  ]
}

class Polygon : Shape {
  describe [|
    _ := super describe.
    _ := '[Polygon]' print.
  ]
}

class Rectangle : Polygon {
  setW:h: [ :w :h |
    _ := self w: w.
    _ := self h: h.
    _ := self.
  ]
  area [|
    _ := (self w) multiplyBy: (self h).
  ]
  describe [|
    _ := super describe.
    _ := '[Rectangle]' print.
  ]
}

class Square : Rectangle {
  setSide: [ :s |
    _ := self setW: s h: s.
    _ := self.
  ]
  describe [|
    _ := super describe.
    _ := '[Square]' print.
  ]
}

class Main : Object {
  run [|
    r := Rectangle new.
    _ := r setW: 4 h: 3.
    sq := Square new.
    _ := sq setSide: 5.

    _ := r describe.
    _ := ((r area) asString) print.
    _ := sq describe.
    _ := ((sq area) asString) print.
  ]
}
