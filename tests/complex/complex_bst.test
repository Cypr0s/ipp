*** Binary search tree: insert values and print inorder
+++ COMPLEX
!C! 0
!I! 0
>>> 5

class BSTNode : Object {
  initVal: [ :v |
    _ := self val: v.
    _ := self left: nil.
    _ := self right: nil.
    _ := self.
  ]
}

class BST : Object {
  init [|
    _ := self root: nil.
    _ := self.
  ]

  insert: [ :v |
    _ := self root: (self insertNode: (self root) val: v).
  ]

  insertNode:val: [ :node :v |
    result := (node isNil)
      ifTrue: [|
        nd := BSTNode new.
        _ := nd initVal: v.
        _ := nd.
      ]
      ifFalse: [|
        _ := (v greaterThan: (node val))
          ifTrue: [|
            _ := node right: (self insertNode: (node right) val: v).
            _ := node.
          ]
          ifFalse: [|
            _ := node left: (self insertNode: (node left) val: v).
            _ := node.
          ].
      ].
  ]

  inorder [|
    _ := self inorderNode: (self root).
  ]

  inorderNode: [ :node |
    _ := (node isNil) ifFalse: [|
      _ := self inorderNode: (node left).
      _ := ((node val) asString) print.
      _ := self inorderNode: (node right).
    ] ifTrue: [| _ := nil. ].
  ]
}

class Main : Object {
  run [|
    t := BST new.
    _ := t init.
    _ := t insert: 5.
    _ := t insert: 3.
    _ := t insert: 7.
    _ := t insert: 1.
    _ := t insert: 4.
    _ := t inorder.
  ]
}
